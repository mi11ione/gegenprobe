{
 "$defs": {
  "DateValue": {
   "additionalProperties": false,
   "description": "An ISO date with provenance (basis=normalised when read from a span like '28. August 2024').",
   "properties": {
    "kind": {
     "const": "value",
     "default": "value",
     "title": "Kind",
     "type": "string"
    },
    "value": {
     "format": "date",
     "title": "Value",
     "type": "string"
    },
    "role": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "semantic role of the value (e.g. a DateRole for dates)",
     "title": "Role"
    },
    "basis": {
     "enum": [
      "extracted",
      "normalised",
      "metadata",
      "inferred"
     ],
     "title": "Basis",
     "type": "string"
    },
    "route": {
     "enum": [
      "metadata",
      "rule",
      "apertus",
      "ocr+rule",
      "ocr+apertus",
      "user_anchor"
     ],
     "title": "Route",
     "type": "string"
    },
    "doc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Document.doc_id the span points into",
     "title": "Doc"
    },
    "page": {
     "anyOf": [
      {
       "minimum": 1,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Page"
    },
    "char_start": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Char Start"
    },
    "char_end": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Char End"
    },
    "quote": {
     "anyOf": [
      {
       "maxLength": 400,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "verbatim source text at the span (short)",
     "title": "Quote"
    },
    "context": {
     "anyOf": [
      {
       "maxLength": 400,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "the source line around the span, for review (not checked)",
     "title": "Context"
    },
    "source": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "structured record for basis=metadata, e.g. 'opd:events/618276'",
     "title": "Source"
    },
    "model_build": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Model Build"
    },
    "theta": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Theta"
    },
    "margin": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "null margin of the forced choice (nats); value kept iff margin <= theta",
     "title": "Margin"
    },
    "candidates": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "size of the closed candidate set the model chose from",
     "title": "Candidates"
    },
    "rule": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "id of the deterministic rule that produced the value (route rule / ocr+rule; user_anchor:<id> for route user_anchor)",
     "title": "Rule"
    },
    "decision_number": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "the executive's decision number printed with the date (RRB-Nr., ACE, RG n.), if the rule captured it",
     "title": "Decision Number"
    }
   },
   "required": [
    "value",
    "basis",
    "route"
   ],
   "title": "DateValue",
   "type": "object"
  },
  "Document": {
   "additionalProperties": false,
   "properties": {
    "doc_id": {
     "description": "stable id, e.g. 'opd:404590', 'be-ogd:0778ef86...', 'fedlex:eli/fga/2014/2095/de'",
     "title": "Doc Id",
     "type": "string"
    },
    "source": {
     "enum": [
      "opd",
      "canton",
      "commune",
      "fedlex",
      "curia_vista",
      "other"
     ],
     "title": "Source",
     "type": "string"
    },
    "url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Url"
    },
    "sha256": {
     "anyOf": [
      {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Sha256"
    },
    "role": {
     "enum": [
      "question",
      "answer",
      "decision",
      "message",
      "report",
      "minutes",
      "agenda",
      "annex",
      "publication",
      "placeholder",
      "other"
     ],
     "title": "Role",
     "type": "string"
    },
    "language": {
     "anyOf": [
      {
       "enum": [
        "de",
        "fr",
        "it",
        "rm",
        "en"
       ],
       "type": "string"
      },
      {
       "const": "unspecified",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "'unspecified' = the source records no language (OPD's empty field); None = not known to us",
     "title": "Language"
    },
    "n_pages": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "N Pages"
    },
    "extractor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "pdftotext-<ver> | tesseract-<ver>-<langs> | opd-text",
     "title": "Extractor"
    },
    "image_only": {
     "default": false,
     "title": "Image Only",
     "type": "boolean"
    },
    "opd_text_status": {
     "anyOf": [
      {
       "enum": [
        "ok",
        "null",
        "blank",
        "failed",
        "placeholder"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Opd Text Status"
    },
    "parts": {
     "default": [],
     "items": {
      "$ref": "#/$defs/DocumentPart"
     },
     "title": "Parts",
     "type": "array"
    }
   },
   "required": [
    "doc_id",
    "source",
    "role"
   ],
   "title": "Document",
   "type": "object"
  },
  "DocumentPart": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "table",
      "annex",
      "image",
      "signature",
      "stamp",
      "handwriting",
      "header",
      "footer",
      "budget_table",
      "toc"
     ],
     "title": "Kind",
     "type": "string"
    },
    "page_from": {
     "minimum": 1,
     "title": "Page From",
     "type": "integer"
    },
    "page_to": {
     "minimum": 1,
     "title": "Page To",
     "type": "integer"
    },
    "label": {
     "anyOf": [
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Label"
    }
   },
   "required": [
    "kind",
    "page_from",
    "page_to"
   ],
   "title": "DocumentPart",
   "type": "object"
  },
  "ExtractionRun": {
   "additionalProperties": false,
   "properties": {
    "converter_version": {
     "title": "Converter Version",
     "type": "string"
    },
    "schema_version": {
     "const": "0.1.0",
     "default": "0.1.0",
     "title": "Schema Version",
     "type": "string"
    },
    "created": {
     "format": "date-time",
     "title": "Created",
     "type": "string"
    },
    "builds": {
     "default": [],
     "description": "model builds consulted (e.g. 'gguf:apertus-v1.5-8b-text-q4_k_m')",
     "items": {
      "type": "string"
     },
     "title": "Builds",
     "type": "array"
    },
    "notes": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Notes"
    }
   },
   "required": [
    "converter_version",
    "created"
   ],
   "title": "ExtractionRun",
   "type": "object"
  },
