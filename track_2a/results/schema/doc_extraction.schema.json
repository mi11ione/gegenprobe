 },
 "additionalProperties": false,
 "description": "What ONE document says, as the converter read it (convert.cascade). Affair-level assembly (metadata events, link\nstatus, several documents) happens in `Affair`; a DocExtraction is what a reviewer checks against a single PDF.\n`recommendation` / `related_affair` are absent when the converter was not asked for them.",
 "properties": {
  "schema_version": {
   "const": "0.1.0",
   "default": "0.1.0",
   "title": "Schema Version",
   "type": "string"
  },
  "doc": {
   "$ref": "#/$defs/Document"
  },
  "answer_date": {
   "discriminator": {
    "mapping": {
     "null": "#/$defs/TypedNull",
     "value": "#/$defs/DateValue"
    },
    "propertyName": "kind"
   },
   "oneOf": [
    {
     "$ref": "#/$defs/DateValue"
    },
    {
     "$ref": "#/$defs/TypedNull"
    }
   ],
   "title": "Answer Date"
  },
  "recommendation": {
   "anyOf": [
    {
     "discriminator": {
      "mapping": {
       "null": "#/$defs/TypedNull",
       "value": "#/$defs/GovRecommendationValue"
      },
      "propertyName": "kind"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/GovRecommendationValue"
      },
      {
       "$ref": "#/$defs/TypedNull"
      }
     ]
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Recommendation"
  },
  "related_affair": {
   "anyOf": [
    {
     "discriminator": {
      "mapping": {
       "null": "#/$defs/TypedNull",
       "value": "#/$defs/TextValue"
      },
      "propertyName": "kind"
     },
     "oneOf": [
