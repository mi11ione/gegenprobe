  "TypedNull": {
   "additionalProperties": false,
   "description": "An explicit, typed absence. A converter never returns a bare None for a field it was asked to fill.",
   "properties": {
    "kind": {
     "const": "null",
     "default": "null",
     "title": "Kind",
     "type": "string"
    },
    "null_reason": {
     "enum": [
      "not_in_corpus",
      "unlinked",
      "text_failed",
      "image_only",
      "oral",
      "present_unanchored",
      "not_applicable",
      "not_in_document",
      "no_rules_for_body"
     ],
     "title": "Null Reason",
     "type": "string"
    },
    "role": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
