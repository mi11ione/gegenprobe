      "ocr+apertus",
      "user_anchor"
     ],
     "title": "Route",
     "type": "string"
    },
    "evidence": {
     "description": "why: the record, rule or abstention that established the null",
     "minLength": 1,
     "title": "Evidence",
     "type": "string"
    },
    "doc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
