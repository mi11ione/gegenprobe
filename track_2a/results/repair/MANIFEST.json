{
 "note": "Every repair list under results/repair, the command that writes it and which list wins where two lists name the same affair (precedence). Adapter lists: apply rows with counted=true (verified=true is the same); tier=review rows are for a person. No two files under results/repair share a name.",
 "precedence": [
  {
   "lists": "adapter list vs route list, action=ocr (same affair)",
   "wins": "adapter list",
   "why": "the route's ocr rows are candidates (OPD holds the answer file without usable text; no text read, verified empty). The adapters ran on every one of those affairs, read or OCR'd the text and checked it: their row (tier says whether it counts) replaces the candidate. A candidate whose affair has no adapter row (the adapter failed: no usable text, identity or heading not found) stays the only row for it."
  },
  {
   "lists": "adapter list vs route list, action=agenda_join or retype_oral (same affair)",
   "wins": "no overlap",
   "why": "agenda joins are census link status agenda, retype_oral is Valais' oral-answer pointer; the adapters only take absent and image_only affairs. Checked on every run (overlaps below)."
  },
  {
   "lists": "route list repair_<BODY>.tsv vs repair_<BODY>_<action>.tsv",
   "wins": "either (same rows)",
   "why": "the per-action files are the combined file split by action; apply one or the other, not both."
  },
  {
   "lists": "repair_BE_relink.tsv / repair_BE_begin_date.tsv vs apply_be/apply_BE_plan.*",
   "wins": "apply_be plan for execution",
   "why": "the plan is built from the two lists and guards every UPDATE with the before-state (repair.apply_be)."
  },
  {
   "lists": "results/ vs site/downloads/",
   "wins": "identical",
   "why": "site/downloads holds byte-identical copies of the lists it offers (sha256 below)."
  }
 ],
