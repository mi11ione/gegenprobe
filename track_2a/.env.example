# Optional. Without these, `make run` replays the hash-checked model cache and skips the live slice.
# Any vLLM-style OpenAI-compatible endpoint serving Apertus. The closed-set pointer needs the vLLM extras
# (continue_final_message + prompt_logprobs); free generation works on any OpenAI-compatible server.
LLM_NAME=swiss-ai/apertus-v1.5-8b
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=
# GP_GGUF=1 scores the live slice locally with Apertus v1.5 8B GGUF Q4_K_M on CPU (5.1 GB download, sha256-pinned;
# build the image with `make run GGUF=1`).
GP_GGUF=0
