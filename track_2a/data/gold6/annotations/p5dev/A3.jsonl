{"affair_id": 158002, "questions": [{"n": 1, "span": {"doc": "question", "page": 1, "start": "1. Gemäss Ausführungen des Regierungsrates waren", "end_page": 1, "end": "vertieft geprüft?"}}, {"n": 2, "span": {"doc": "question", "page": 1, "start": "2. Der Kantonsrat hat die Botschaft B 12", "end_page": 1, "end": "gesundheitspolitischen Verantwortung?"}}, {"n": 3, "span": {"doc": "question", "page": 1, "start": "3. Gilt die Besitzstandswahrung", "end_page": 1, "end": "SMN SA eingeleitet hat?"}}, {"n": 4, "span": {"doc": "question", "page": 1, "start": "4. Wie beurteilt der Regierungsrat aus staatspolitischer", "end_page": 1, "end": "ausgeübt werden kann?"}}, {"n": 5, "span": {"doc": "question", "page": 1, "start": "5. In welcher Form wird", "end_page": 1, "end": "Rechtsunsicherheit geklärt wird?"}}, {"n": 6, "span": {"doc": "question", "page": 1, "start": "6. Ist dem Regierungsrat bekannt", "end_page": 2, "end": "Eignerstrategie angesehen wurde?"}}, {"n": 7, "span": {"doc": "question", "page": 2, "start": "7. Wie beurteilt der Regierungsrat in seiner Rolle", "end_page": 2, "end": "Steuerzahlenden zu erwarten?"}}], "question_style": "enumerated", "answer_style": "per_question", "answers": [{"n": 1, "span": {"doc": "answer", "page": 1, "start": "Das LUKS hat im Auftrag des Regierungsrates", "end_page": 2, "end": "der personellen Verantwortung Rechnung."}, "joint_with": []}, {"n": 2, "span": {"doc": "answer", "page": 2, "start": "Ja, der Regierungsrat nimmt seine gesundheitspolitische", "end_page": 2, "end": "Standort mit Tradition."}, "joint_with": []}, {"n": 3, "span": {"doc": "answer", "page": 2, "start": "Für das Personal der LHM gelten nach wie vor", "end_page": 2, "end": "Bis dahin gilt der bisherige Rahmen."}, "joint_with": []}, {"n": 4, "span": {"doc": "answer", "page": 3, "start": "Die staatspolitische Verantwortung besteht darin", "end_page": 3, "end": "der Spitalgesetzänderung zugestimmt."}, "joint_with": []}, {"n": 5, "span": {"doc": "answer", "page": 3, "start": "Die Rechtsordnung sieht keine bedingten", "end_page": 3, "end": "keine weitere Zustimmung des Kantonsrates."}, "joint_with": []}, {"n": 6, "span": {"doc": "answer", "page": 3, "start": "Nein, es gibt keine Hinweise auf", "end_page": 3, "end": "sehr hohe Behandlungsqualität hin."}, "joint_with": []}, {"n": 7, "span": {"doc": "answer", "page": 4, "start": "Der Regierungsrat hat keine Anhaltspunkte für ein Missmanagement.", "end_page": 4, "end": "Steuerzahlenden anfallende Kosten vermieden."}, "joint_with": []}], "submitter": {"name": "Gianluca Pardini", "doc": "question", "page": 1, "quote": "Anfrage Pardini Gianluca und Mit. über die Mitsprache des Parlaments"}, "co_signatories": [{"name": "Galbraith Sofia", "doc": "question", "page": 2, "quote": "Galbraith Sofia"}, {"name": "Sager Urban", "doc": "question", "page": 2, "quote": "Sager Urban"}, {"name": "Muff Sara", "doc": "question", "page": 2, "quote": "Muff Sara"}, {"name": "Horat Marc", "doc": "question", "page": 2, "quote": "Horat Marc"}, {"name": "Schuler Josef", "doc": "question", "page": 2, "quote": "Schuler Josef"}, {"name": "Meier Anja", "doc": "question", "page": 2, "quote": "Meier Anja"}, {"name": "Budmiger Marcel", "doc": "question", "page": 2, "quote": "Budmiger Marcel"}, {"name": "Engler Pia", "doc": "question", "page": 2, "quote": "Engler Pia"}, {"name": "Zbinden Samuel", "doc": "question", "page": 2, "quote": "Zbinden Samuel"}, {"name": "Koch Hannes", "doc": "question", "page": 2, "quote": "Koch Hannes"}, {"name": "Heselhaus Sabine", "doc": "question", "page": 2, "quote": "Heselhaus Sabine"}, {"name": "Bolliger Roman", "doc": "question", "page": 2, "quote": "Bolliger Roman"}, {"name": "Irniger Barbara", "doc": "question", "page": 2, "quote": "Irniger Barbara"}, {"name": "Waldvogel Gian", "doc": "question", "page": 2, "quote": "Waldvogel Gian"}, {"name": "Kummer Thomas", "doc": "question", "page": 2, "quote": "Kummer Thomas"}, {"name": "Brunner Simone", "doc": "question", "page": 2, "quote": "Bru