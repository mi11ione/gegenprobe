# Copy to /etc/gegenprobe/alerts.env (chmod 600). Every line is optional; with none set, alerts are only written to
# alerts.json and the journal.
# GP_ALERT_WEBHOOK=https://hooks.example.org/…        # JSON POST with a `text` field (Slack/Teams/Matrix bridges)
# GP_ALERT_SMTP_HOST=mail.example.ch
# GP_ALERT_SMTP_PORT=587
# GP_ALERT_SMTP_USER=
# GP_ALERT_SMTP_PASSWORD=
# GP_ALERT_MAIL_FROM=gegenprobe@example.ch
# GP_ALERT_MAIL_TO=data@example.ch
# GP_ALERT_EXIT=3                                       # exit code on alerts (0 = keep the unit green)
