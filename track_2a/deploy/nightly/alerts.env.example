# Copy to /etc/gegenprobe/alerts.env (chmod 600). One setting is required: GP_USER_AGENT (identity, below; its placeholder
# fails closed until you set it). Every other setting is optional; with none set, alerts are only written to alerts.json
# and the journal, and the defaults below apply. Two settings are active in this template: GP_ADAPTER_CANARY=1 and the
# GP_USER_AGENT placeholder.
# Format: KEY=value, one per line. Comments go on their OWN line: docker's --env-file and systemd's EnvironmentFile do not
# strip a trailing "# ..." from a value line, it would become part of the value.

# ---- alert routing
# JSON POST with a `text` field (Slack/Teams/Matrix bridges)
#GP_ALERT_WEBHOOK=https://hooks.example.org/...
# one mail per night with alerts (STARTTLS)
#GP_ALERT_SMTP_HOST=mail.example.ch
#GP_ALERT_SMTP_PORT=587
#GP_ALERT_SMTP_USER=
#GP_ALERT_SMTP_PASSWORD=
#GP_ALERT_MAIL_FROM=gegenprobe@example.ch
#GP_ALERT_MAIL_TO=data@example.ch
# exit code on a night with alerts (0 = keep the unit green; default 3)
#GP_ALERT_EXIT=3
# alert when the newest export in index.json is older than this many days (default 2)
#GP_STALE_DAYS=2
# adapter canaries: re-check one known affair per external source the adapters read (7 sources, about 45 requests and
# 70 s; selection results/repair/adapters/canary.json; live run of 11 Oct 2026, 7 of 7 verified in 67.6 s:
# results/repair/adapters/canary_runs/2026-10-11.json); alerts adapter_canary_failed / _text_changed /
# adapter_counted_drop. On by default; set 0 to turn off (a host that cannot reach the source parliaments)
GP_ADAPTER_CANARY=1

# ---- identity and sources
# User-Agent of every request. REQUIRED: a network night refuses to start (exit 1, nothing fetched) until this names
# your OWN product token and a contact URL that reaches you (http:// or https://; an e-mail address, a reserved example
# domain and the placeholder below are refused). install.sh --user-agent "..." writes it here. Replace the whole value, e.g.
# GP_USER_AGENT=openparldata-gegenprobe/0.1 (+https://www.openparldata.ch)
GP_USER_AGENT=SET-ME/0.1 (+https://set-me.invalid/your-contact-page)
# Read the exports from OPD's own export directory instead of downloading them (no transfer; recommended inside OPD)
#GP_EXPORTS_DIR=/srv/opd/exports

# ---- limits for untrusted documents
# per-PDF download cap in MB (default 50) and cap for other in-memory downloads (default 100)
#GP_MAX_PDF_MB=50
#GP_MAX_DOWNLOAD_MB=100
# timeout per pdftotext / pdftoppm / tesseract call in seconds (default 300)
#GP_SUBPROCESS_TIMEOUT=300
# ceiling per document (fetch + text extraction + OCR) in seconds (default 600)
#GP_DOC_BUDGET_S=600

# ---- docker unit only: container resource ceiling (defaults 4g / 2)
#GP_MEM=4g
#GP_CPUS=2
