# Variant without Docker: a checkout in /opt/gegenprobe/track_2a with a Python 3.11 venv in /opt/gegenprobe/.venv
# (pip install --require-hashes -r requirements.lock) and poppler-utils + tesseract-ocr{,-deu,-fra,-ita} from the
# distribution. Same timer, same outputs. The checkout stays read-only for the job: everything it writes goes to
# /var/lib/gegenprobe (work/ = caches and state, results/ = rates, alerts, ledger), owned by the `gegenprobe` system user
# that install.sh creates.
[Unit]
Description=Gegenprobe nightly (no Docker): OpenParlData answer-linking monitor and repair lists
Wants=network-online.target
After=network-online.target
# failure notifier: posts for failures only (alerts are delivered by the job itself), so each event arrives once
OnFailure=gegenprobe-nightly-failure.service

[Service]
Type=oneshot
User=gegenprobe
Group=gegenprobe
StateDirectory=gegenprobe
StateDirectoryMode=0750
WorkingDirectory=/var/lib/gegenprobe
EnvironmentFile=-/etc/gegenprobe/alerts.env
Environment=PYTHONPATH=/opt/gegenprobe/track_2a/src PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/gegenprobe
Environment=GP_WORK=/var/lib/gegenprobe/work GP_MONITOR_OUT=/var/lib/gegenprobe/results
ExecStart=/opt/gegenprobe/.venv/bin/python -m gegenprobe.monitor.nightly run
TimeoutStartSec=4h
Nice=10
# Resource ceiling (cgroup v2). Measured peak: see docs/runbook.md "Resources".
MemoryMax=4G
CPUQuota=200%
TasksMax=256
# Sandboxing: the job needs outbound HTTPS, read access to /opt/gegenprobe and the system's poppler/tesseract, and write
# access to /var/lib/gegenprobe; nothing else. Exposure score: `systemd-analyze security` (CI job systemd-units fails above
# the threshold documented in docs/runbook.md "Sandboxing").
# file system: read-only OS and /opt checkout, no /home, private /tmp (pdftoppm/tesseract scratch), writes only to the state dir
ProtectSystem=strict
ReadWritePaths=/var/lib/gegenprobe
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
UMask=0027
# identity: no capabilities at all, no way to gain any (setuid binaries, file capabilities), own user namespace
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
PrivateUsers=yes
RemoveIPC=yes
# kernel: no tunables, modules, kernel log, clock, hostname or cgroup changes; /proc shows only the job's own processes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# network: IPv4/IPv6 sockets for HTTPS and DNS, Unix sockets for the resolver and journal; no netlink, packet or others.
# Not set: PrivateNetwork= and IPAddressDeny= (the job fetches from files.openparldata.ch, the canton and the source sites).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# system calls: native ABI only; the @system-service set without the privileged calls (chown, setuid, clock, mount, ...)
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Not set: MemoryDenyWriteExecute= (Python's ctypes/libffi trampolines need W+X pages on some builds; low weight in the
# score) and ProcSubset=pid (tesseract and the OpenMP runtime read /proc/cpuinfo-style files on some platforms).
