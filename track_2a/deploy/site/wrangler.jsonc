// Evidence viewer on Cloudflare (static assets only, no Worker code, no data processing).
// Deploy: CLOUDFLARE_API_TOKEN=... npx wrangler@4.149.0 deploy   (from this directory)
{
  "name": "gegenprobe",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../../site", "not_found_handling": "single-page-application" },
  "workers_dev": true,
  "routes": [{ "pattern": "gegenprobe.mi11ion.io", "custom_domain": true }]
}
